{
  "name": "@mr-robot/host",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Mr. Robot host app: lets your robots use this computer (files, shell, Chrome).",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node build.mjs",
    "start": "node build.mjs && electron dist/main.cjs",
    "dist:win": "node build.mjs --windows && electron-builder --config electron-builder.yml --win nsis --x64",
    "pack:win": "node build.mjs --windows && electron-builder --config electron-builder.yml --win dir --x64"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-agent-instructions": "0.2.1-rc.2",
    "@deepseek-ai/dsh-bash-sandbox": "0.2.1-rc.2",
    "@deepseek-ai/dsh-experimental-worktree": "0.2.1-rc.2",
    "@deepseek-ai/dsh-fs-local": "0.2.1-rc.2",
    "@deepseek-ai/dsh-home-paths": "0.2.1-rc.2",
    "@deepseek-ai/dsh-http-proxy": "0.2.1-rc.2",
    "@deepseek-ai/dsh-jobs": "0.2.1-rc.2",
    "@deepseek-ai/dsh-jobs-local": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-lsp": "0.2.1-rc.2",
    "@deepseek-ai/dsh-lsp-stdio": "0.2.1-rc.2",
    "@deepseek-ai/dsh-pwsh-local": "0.2.1-rc.2",
    "@deepseek-ai/dsh-pwsh-sandbox": "0.2.1-rc.2",
    "@deepseek-ai/dsh-sandbox": "0.2.1-rc.2",
    "@deepseek-ai/dsh-sandbox-local": "0.2.1-rc.2",
    "@deepseek-ai/dsh-sandbox-windows-acl": "0.2.1-rc.2",
    "@deepseek-ai/dsh-shell": "0.2.1-rc.2",
    "@deepseek-ai/dsh-skill": "0.2.1-rc.2",
    "@deepseek-ai/dsh-skill-filesystem": "0.2.1-rc.2",
    "@deepseek-ai/dsh-subprocess": "0.2.1-rc.2",
    "@deepseek-ai/dsh-subprocess-local": "0.2.1-rc.2",
    "@mr-robot/host-protocol": "workspace:*",
    "effect": "4.0.1",
    "ws": "8.18.3",
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@types/ws": "8.18.1",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.1"
  }
}
